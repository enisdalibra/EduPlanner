{
  "name": "eduplanner-local",
  "private": true,
  "version": "0.1.0-beta.1",
  "description": "An offline-first teacher workspace for managing classes, attendance, grades, teaching materials, schedules, and tasks.",
  "author": "Enisda Libra Kelana",
  "license": "MIT",
  "homepage": "https://github.com/enisdalibra/EduPlanner#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/enisdalibra/EduPlanner.git"
  },
  "bugs": {
    "url": "https://github.com/enisdalibra/EduPlanner/issues"
  },
  "keywords": [
    "education",
    "teacher",
    "offline-first",
    "pwa",
    "react",
    "indexeddb"
  ],
  "engines": {
    "node": ">=22.22.0"
  },
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000",
    "build": "npm run icons:subset && vite build && npm run verify:bundle && npm run test:offline",
    "preview": "vite preview --host 127.0.0.1 --port 4173 --strictPort",
    "clean": "node scripts/clean.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "npm run typecheck",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "icons:subset": "node scripts/subset-material-icons.mjs",
    "verify:bundle": "node scripts/check-bundle-budget.mjs",
    "test:offline": "node scripts/check-offline-build.mjs",
    "privacy:check": "node scripts/check-sensitive-files.mjs",
    "check:release-artifact": "node scripts/check-release-artifact.mjs",
    "verify": "npm run typecheck && npm run test:coverage && npm run build && npm run check:release-artifact && npm audit",
    "release:check": "npm run privacy:check && npm run verify"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@fontsource/inter": "^5.3.0",
    "@tanstack/react-virtual": "^3.14.9",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "dexie": "^4.4.4",
    "dexie-react-hooks": "^4.4.0",
    "next-themes": "^0.4.6",
    "react": "^19.2.7",
    "react-day-picker": "^9.14.0",
    "react-dom": "^19.2.7",
    "react-markdown": "^10.1.0",
    "react-router": "8.3.0",
    "read-excel-file": "^9.3.5",
    "recharts": "^3.10.1",
    "remark-gfm": "^4.0.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "write-excel-file": "^4.1.1",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.4.0",
    "@vitejs/plugin-react": "^6.1.0",
    "@vitest/coverage-v8": "^4.1.11",
    "@vitest/ui": "^4.1.6",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^30.0.1",
    "material-symbols": "^0.47.0",
    "subset-font": "^2.5.0",
    "tailwindcss": "^4.1.14",
    "tw-animate-css": "^1.4.0",
    "typescript": "~5.8.2",
    "vite": "^8.2.2",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.6"
  },
  "overrides": {
    "brace-expansion": "5.0.9"
  }
}
